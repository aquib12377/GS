# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32

# Neon / Supabase / any Postgres connection string
# Format: postgres://user:password@host/dbname?sslmode=require
DATABASE_URI=postgres://user:password@host/dbname?sslmode=require

# Vercel Blob token — get from: vercel env pull
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# Public URL of the deployed site
NEXT_PUBLIC_SERVER_URL=https://your-project.vercel.app

# Only used by the seed script
SEED_ADMIN_PASSWORD=change-me
