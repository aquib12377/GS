# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-openssl-rand-base64-32

# --- Database ---
# Local dev (SQLite file, auto-created):
DATABASE_URI=file:./data/blog.db

# Turso (production on Vercel):
# DATABASE_URI=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=eyJhbGci...

# --- Media ---
# Vercel Blob token — get from: vercel env pull
# Leave blank for local dev (falls back to local file storage)
BLOB_READ_WRITE_TOKEN=

# --- App ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Only used by the seed script
SEED_ADMIN_PASSWORD=change-me
